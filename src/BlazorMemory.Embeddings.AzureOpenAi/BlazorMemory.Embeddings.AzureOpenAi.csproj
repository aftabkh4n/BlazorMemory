<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>BlazorMemory.Embeddings.AzureOpenAi</PackageId>
    <Version>1.1.0</Version>
    <Description>Azure OpenAI embeddings provider for BlazorMemory. Connects to your Azure OpenAI resource using deployment names.</Description>
    <PackageTags>blazor;ai;memory;azure;openai;embeddings;vectors;persistent-memory;ai-agent;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlazorMemory.Core\BlazorMemory.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MSExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MSExtensionsVersion)" />
  </ItemGroup>
</Project>
