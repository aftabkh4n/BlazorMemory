<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>BlazorMemory.Extractor.Ollama</PackageId>
    <Version>1.1.0</Version>
    <Description>Ollama-powered fact extractor and memory consolidator for BlazorMemory. Run local LLMs like llama3.2 or mistral — no API key required.</Description>
    <PackageTags>blazor;ai;memory;ollama;llama;extraction;llm;local;persistent-memory;ai-agent;aspnetcore</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlazorMemory.Core\BlazorMemory.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MSExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MSExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MSExtensionsVersion)" />
  </ItemGroup>
</Project>
