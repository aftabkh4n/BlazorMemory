<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<PackageId>BlazorMemory.Storage.IndexedDb</PackageId>
		<Version>1.1.0</Version>
		<Description>Browser IndexedDB storage adapter for BlazorMemory. Zero-backend persistent memory for Blazor WebAssembly apps — everything stays in the user's browser.</Description>
		<PackageTags>blazor;wasm;ai;memory;indexeddb;browser;offline;persistent-memory</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\BlazorMemory.Core\BlazorMemory.Core.csproj" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(AspNetCoreVersion)" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MSExtensionsVersion)" />
	</ItemGroup>
</Project>
