<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>BlazorMemory.Storage.EfCore</PackageId>
		<Version>1.1.0</Version>
		<Description>Entity Framework Core storage adapter for BlazorMemory. Supports SQL Server, PostgreSQL, and SQLite for server-side Blazor and ASP.NET Core apps.</Description>
		<PackageTags>blazor;ai;memory;efcore;postgresql;sqlserver;sqlite;persistent-memory;ai-agent;aspnetcore</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\BlazorMemory.Core\BlazorMemory.Core.csproj" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EFCoreVersion)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EFCoreVersion)" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MSExtensionsVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MSExtensionsVersion)" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="$(MSExtensionsVersion)" />
	</ItemGroup>
</Project>
