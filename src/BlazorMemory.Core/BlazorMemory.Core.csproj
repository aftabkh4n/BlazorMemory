<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>BlazorMemory</PackageId>
		<Version>1.1.0</Version>
		<Description>AI memory layer for .NET — LLM-powered fact extraction, intelligent consolidation, vector search, and staleness scoring. Works in Blazor WASM (browser) or server-side ASP.NET Core.</Description>
		<PackageTags>blazor;ai;memory;llm;vector;embeddings;wasm;dotnet;openai;anthropic;persistent-memory;ai-agent;aspnetcore;agent-framework;microsoft-extensions-ai</PackageTags>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\assets\icon.png')" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MSExtensionsVersion)" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MSExtensionsVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MSExtensionsVersion)" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="$(MSExtensionsVersion)" />
	</ItemGroup>
</Project>
