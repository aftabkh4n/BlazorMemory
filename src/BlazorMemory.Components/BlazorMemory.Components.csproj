<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>BlazorMemory.Components</PackageId>
    <Version>1.1.0</Version>
    <Description>Drop-in Blazor UI components for BlazorMemory. Add a memory panel to your app with a single component.</Description>
    <PackageTags>blazor;ai;memory;components;ui;persistent-memory;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aftabkh4n/BlazorMemory</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(AspNetCoreVersion)" />
    <PackageReference Include="Microsoft.JSInterop" Version="$(AspNetCoreVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlazorMemory.Core\BlazorMemory.Core.csproj" />
  </ItemGroup>
</Project>
