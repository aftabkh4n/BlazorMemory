<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>BlazorMemory.SemanticKernel</PackageId>
    <Version>1.1.0</Version>
    <Description>Legacy Semantic Kernel IMemoryStore adapter for BlazorMemory. Superseded by BlazorMemory.AgentFramework — use that for new work targeting Microsoft Agent Framework.</Description>
    <PackageTags>blazor;ai;memory;semantic-kernel;vector-search;legacy;persistent-memory</PackageTags>
    <NoWarn>$(NoWarn);SKEXP0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlazorMemory.Core\BlazorMemory.Core.csproj" />
    <PackageReference Include="Microsoft.SemanticKernel.Core" Version="1.79.0" />
  </ItemGroup>
</Project>
